{
  "realm": "todo-app",
  "displayName": "TODO App",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationEmailAsUsername": false,
  "verifyEmail": false,
  "loginTheme": "todo-theme",
  "internationalizationEnabled": true,
  "supportedLocales": ["pl", "en"],
  "defaultLocale": "pl",
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "TODO App",
    "auth": "${SMTP_AUTH}",
    "ssl": "false",
    "starttls": "${SMTP_STARTTLS}",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}"
  },
  "roles": {
    "realm": [
      { "name": "user", "description": "Zwykły użytkownik" },
      { "name": "admin", "description": "Administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "todo-frontend",
      "name": "TODO frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@todo.local",
      "emailVerified": true,
      "firstName": "Jan",
      "lastName": "Kowalski",
      "credentials": [{ "type": "password", "value": "user123", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@todo.local",
      "emailVerified": true,
      "firstName": "Anna",
      "lastName": "Nowak",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["admin", "user"]
    }
  ]
}
