# npm run dev:mobile detects the LAN address and supplies these values.
# Set them manually only when starting Expo without that helper script.
# EXPO_PUBLIC_API_URL=http://<computer-lan-ip>:8080
# EXPO_PUBLIC_MOCK_API_URL=http://<computer-lan-ip>:3001
# EXPO_PUBLIC_KEYCLOAK_URL=http://<computer-lan-ip>:8081
# EXPO_PUBLIC_KEYCLOAK_REALM=todo-app
# EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=todo-mobile
