{
  "name": "todo/backend",
  "description": "Symfony API for the TODO application",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "firebase/php-jwt": "^7.2",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
